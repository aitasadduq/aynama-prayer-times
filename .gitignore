# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

.DS_Store
.gstack/
.claude/
.claire/

# Android build outputs
android/local.properties
android/.gradle/

# Script generator artifacts. The Adhan JAR is downloaded from Maven Central on demand and
# pinned by scripts/reference-versions.json, so it is reproducible without being committed.
scripts/*.jar
scripts/*.class
scripts/disagreements.json
scripts/adhan-parity/*.jar
scripts/adhan-parity/*.jar.part
scripts/adhan-parity/*.class

# Xcode / SwiftPM
.build/
.swiftpm/
DerivedData/
# The Xcode project is generated from ios/project.yml by XcodeGen, so it is build output here
# and not the source of truth its extension normally implies.
*.xcodeproj/
*.xcworkspace/
# Generated by XcodeGen from ios/project.yml, which is the reviewable source of truth.
ios/App/Info.plist

# Package.resolved is deliberately NOT ignored. Adhan-Swift is pinned exactly, and committing
# the resolution is what makes a CI checkout reproduce this exact dependency graph.
